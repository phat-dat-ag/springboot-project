# Copy .env.example to .env; fill every Required entry.
# Also copy .env.user-api.example, .env.learning-api.example and .env.jwks-api.example
# to their names without .example.
# Configure matching key IDs and mounted PEM files before starting Compose.

# Root Compose interpolation settings; this file is not a container env_file.
# Shell variables override these settings. Required entries must be nonempty.
# Optional entries use the shown Compose default when unset or empty.
# Keep real env files untracked. Preserve quoting; single quotes prevent $ interpolation.
# Internal ports, bind addresses and container paths stay fixed to match mounts/health checks.

# --- Shared authentication ---
# Required; exact issuer string used by both APIs.
JWT_ISSUER=

# --- MySQL ---
# Required; database name: 1-64 ASCII letters, digits, underscores or hyphens.
MYSQL_DATABASE=
# Required; database login: same format as MYSQL_DATABASE.
MYSQL_USER=
# Required; nonblank; no quotes, backslashes or control characters (image constraint).
MYSQL_PASSWORD=
# Required; same password constraints as MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=
# Optional; available loopback host port, 1-65535.
MYSQL_HOST_PORT=3336

# --- PostgreSQL ---
# Required; database name; use a simple SQL identifier.
POSTGRES_DB=
# Required; database owner/login role.
POSTGRES_USER=
# Required; nonempty database password.
POSTGRES_PASSWORD=
# Optional; available loopback host port, 1-65535.
POSTGRES_HOST_PORT=5432

# --- Shared Flyway settings ---
# Optional; connection retry count, nonnegative integer.
FLYWAY_CONNECT_RETRIES=60

# --- flyway-mysql ---
# Optional; APP_NAME passed to this container; default flyway-mysql.
# Container metadata only; this is not a native Flyway configuration setting.
FLYWAY_MYSQL_APP_NAME=flyway-mysql
# Optional; host migration directory, relative to this project or absolute.
USER_API_MIGRATION_PATH=./db/migration/user

# --- flyway-postgres ---
# Optional; host migration directory, mounted read-only.
LEARNING_API_MIGRATION_PATH=./db/migration/learning

# --- Shared user-api / flyway-mysql logging ---
# Optional; Flyway log directory. user-api always logs to its mounted /app/data/logs.
APP_LOG_DIR=/app/data/logs
# Optional; logging level for user-api and flyway-mysql: DEBUG, INFO, WARN, ERROR.
LOG_LEVEL=INFO

# --- user-api ---
# Optional; service log filename/name; default user-api.
USER_API_APP_NAME=user-api
# Optional; available loopback host HTTP port, 1-65535.
USER_API_HOST_PORT=8080
# Optional; existing host private-key directory, mounted at /run/keys/jwt.
USER_SIGNING_KEYS_DIR=./key
# Optional; JWKS HTTP(S) URL reachable from this container; mapped to JWT_JWK_SET_URI.
USER_JWT_JWK_SET_URI=http://jwks-api:8080/.well-known/jwks.json
# Optional; positive integer access-token lifetime in seconds.
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# Optional; positive integer refresh-token lifetime in days.
JWT_REFRESH_TOKEN_TTL_DAYS=30

# --- learning-api ---
# Optional; service log filename/name; default learning-api.
LEARNING_API_APP_NAME=learning-api
# Optional; available loopback host HTTP port, 1-65535.
LEARNING_API_HOST_PORT=8081
# Optional; application logging level.
LEARNING_API_LOG_LEVEL=INFO
# Internal JWT signing. Never put PEM contents or tokens in environment variables.
# Compose enables signing; local Java runs default to disabled unless explicitly enabled.
LEARNING_INTERNAL_JWT_ENABLED=true
LEARNING_INTERNAL_JWT_ISSUER=learning-service
LEARNING_INTERNAL_JWT_AUDIENCE=user-service
# Host directory mounted read-only into Learning; separate from User/JWKS's shared ./key.
LEARNING_SIGNING_KEYS_DIR=./data/keys/learning
# Whole seconds, 1..300; recommended 60 seconds.
LEARNING_INTERNAL_JWT_TTL=60s
# Optional; JWKS HTTP(S) URL reachable from this container; mapped to JWT_JWK_SET_URI.
LEARNING_JWT_JWK_SET_URI=http://jwks-api:8080/.well-known/jwks.json
# Optional; JWT clock tolerance as a duration, e.g. 60s.
JWT_CLOCK_SKEW=60s
# Optional; HTTP(S) base URL for the diagnostic JWKS client; no trailing slash.
JWKS_SERVICE_BASE_URL=http://jwks-api:8080
# Optional; diagnostic JWKS endpoint path; starts with /.
JWKS_SERVICE_GET_PUBLIC_KEYS=/.well-known/jwks.json

# Optional; User Service URL reachable from the learning-api container.
USER_SERVICE_BASE_URL=http://user-api:8080
# Optional; internal user lookup path; starts with /.
USER_SERVICE_GET_USER=/internal/users
# Optional; finite positive durations, at least 1ms and at most 2147483647ms.
USER_SERVICE_CONNECT_TIMEOUT=3s
USER_SERVICE_READ_TIMEOUT=5s
# Attach a fresh Learning JWT to each User request. Enable after User trusts Learning's tokens.
USER_SERVICE_INTERNAL_JWT_ENABLED=false

# --- jwks-api ---
# Optional; service log filename/name; default jwks-api.
JWKS_API_APP_NAME=jwks-api
# Optional; available loopback host HTTP port, 1-65535.
JWKS_API_HOST_PORT=8783
# Optional; application logging level.
JWKS_API_LOG_LEVEL=INFO
# Optional; existing host key directory, mounted at /run/keys/jwt.
JWKS_KEYS_DIR=./key

# --- loki ---
# Optional; available loopback host HTTP port, 1-65535.
LOKI_HOST_PORT=3100

# --- grafana ---
# Required; initial administrator login (existing database retains its account).
GRAFANA_ADMIN_USER=
# Required; initial administrator password (existing database retains its password).
GRAFANA_ADMIN_PASSWORD=
# Optional; available loopback host HTTP port, 1-65535.
GRAFANA_HOST_PORT=3000

# --- opensearch ---
# Optional; available loopback host HTTP port, 1-65535.
OPENSEARCH_HOST_PORT=9200
# Optional; Java heap arguments; keep below the Compose container memory limit.
OPENSEARCH_JAVA_OPTS="-Xms512m -Xmx512m"

# --- opensearch-dashboards ---
# Optional; available loopback host HTTP port, 1-65535.
OPENSEARCH_DASHBOARDS_HOST_PORT=5601
