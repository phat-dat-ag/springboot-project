# Copy to .env.jwks-api. Only public keys belong in this configuration.
# Use consecutive indices and unique kids across all owners. OWNER is required.
# PUBLICKEYPATH is the canonical Spring environment spelling for publicKeyPath.
# User keys remain under JWKS_KEYS_DIR; Learning's public file has its own read-only mount.
# ACTIVE is obsolete here; only the signing services choose active private keys.

APP_SECURITY_JWKS_KEYS_0_KID=user-rsa-v1
APP_SECURITY_JWKS_KEYS_0_PUBLICKEYPATH=/run/keys/jwt/userservice-public-v1.pem
APP_SECURITY_JWKS_KEYS_0_OWNER=USER

APP_SECURITY_JWKS_KEYS_1_KID=user-rsa-v2
APP_SECURITY_JWKS_KEYS_1_PUBLICKEYPATH=/run/keys/jwt/userservice-public-v2.pem
APP_SECURITY_JWKS_KEYS_1_OWNER=USER

APP_SECURITY_JWKS_KEYS_2_KID=learning-rsa-v1
APP_SECURITY_JWKS_KEYS_2_PUBLICKEYPATH=/run/keys/learning/learningservice-public-v1.pem
APP_SECURITY_JWKS_KEYS_2_OWNER=LEARNING

# --- Docker Compose debug settings (root .env only) ---
# Set these in the workspace root .env or shell, not this service env_file.
# They apply only when docker-compose.debug.yml is explicitly included.
# JWKS_API_DEBUG_PORT=5007
# JWKS_API_JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:${JWKS_API_DEBUG_PORT:-5007}
# No DEBUG_ENABLED flag is used; the override file enables debugging.
