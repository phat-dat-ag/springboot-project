# Copy to .env.jwks-api; required values have no sample or default.
# At least key 0 is required. IDs must match .env.user-api.
# Paths refer to container PEM files under /run/keys/jwt (JWKS_KEYS_DIR on host).
# This implementation requires matching RSA private AND public PEM files for each key.
# Use PKCS#8 private keys and X.509 SubjectPublicKeyInfo public keys.
# Exactly one key must have ACTIVE=true; others false. Never paste PEM contents here.
# Additional keys use consecutive indices; configure all fields together.

# Required JWKS key 0
APP_SECURITY_JWKS_KEYS_0_KID=
APP_SECURITY_JWKS_KEYS_0_PRIVATE_KEY_PATH=
APP_SECURITY_JWKS_KEYS_0_PUBLIC_KEY_PATH=
APP_SECURITY_JWKS_KEYS_0_ACTIVE=

# Optional rotation key 1: uncomment all fields and supply values together.
# APP_SECURITY_JWKS_KEYS_1_KID=
# APP_SECURITY_JWKS_KEYS_1_PRIVATE_KEY_PATH=
# APP_SECURITY_JWKS_KEYS_1_PUBLIC_KEY_PATH=
# APP_SECURITY_JWKS_KEYS_1_ACTIVE=
