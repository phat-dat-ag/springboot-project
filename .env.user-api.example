# Copy to .env.user-api; required values have no sample or default.
# At least key 0 is required. IDs must match .env.jwks-api.
# Paths refer to container PEM files under /run/keys/jwt (USER_SIGNING_KEYS_DIR on host).
# Use RSA PKCS#8 private keys. Exactly one key must have ACTIVE=true; others false.
# Additional keys use consecutive indices; configure all fields together.

# Required signing key 0
APP_SECURITY_SIGNING_KEYS_0_KID=
APP_SECURITY_SIGNING_KEYS_0_PRIVATEKEYPATH=
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=

# Optional rotation key 1: uncomment all fields and supply values together.
# APP_SECURITY_SIGNING_KEYS_1_KID=
# APP_SECURITY_SIGNING_KEYS_1_PRIVATEKEYPATH=
# APP_SECURITY_SIGNING_KEYS_1_ACTIVE=

# --- Docker Compose debug settings (root .env only) ---
# Set these in the workspace root .env or shell, not this service env_file.
# They apply only when docker-compose.debug.yml is explicitly included.
# USER_API_DEBUG_PORT=5005
# USER_API_JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:${USER_API_DEBUG_PORT:-5005}
# No DEBUG_ENABLED flag is used; the override file enables debugging.

# --- Phase 0 service observability ---
# Stable default: SPRING_APPLICATION_NAME=user-learning. Preserve it for existing log queries.
# Optional per-service release version; otherwise Maven project.version is used.
# APP_VERSION=0.0.1-SNAPSHOT
# DEPLOYMENT_ENVIRONMENT is supplied by root Compose; configure it in root .env.
# Optional local instrumentation controls; missing dependencies are not added by these flags.
# MANAGEMENT_METRICS_ENABLE_ALL=true
# MANAGEMENT_TRACING_ENABLED=true
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
# MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=false
# MANAGEMENT_LOGGING_EXPORT_OTLP_ENABLED=false
# Standalone exposure defaults to health. Compose uses health,prometheus with port protection.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health

# --- Phase 2 private metrics (standalone opt-in; Compose sets these explicitly) ---
# Never publish the scrape listener on a public host interface.
# METRICS_LISTENER_ENABLED=false
# METRICS_LISTENER_PORT=9091
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,prometheus
# MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true

# Phase 3 standalone trace export (Compose supplies its own internal endpoint):
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=true
# MANAGEMENT_OPENTELEMETRY_TRACING_EXPORT_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Use 1.0 sampling only for controlled development verification.

# --- Phase 6A remediation: bounded stable-name log spool ---
# Optional; defaults preserved. Compose passes root values to all APIs.
# Standalone JVMs read these environment variables directly through Logback.
APP_LOG_MAX_FILE_SIZE=100MB
APP_LOG_MAX_HISTORY=30
APP_LOG_TOTAL_SIZE_CAP=2GB
# Optional listener bind, default 0.0.0.0; production mTLS sidecar requires 127.0.0.1.
# Requires an image built with the remediation metrics-listener configuration.
APP_METRICS_LISTENER_ADDRESS=0.0.0.0
# New files use spool/<APP_NAME>.<date>.<index>.log without rename/compression.
# Quota/history can still delete unread files during excessive downtime; not a lossless SLA.
