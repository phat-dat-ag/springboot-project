          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_idle{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"}",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
