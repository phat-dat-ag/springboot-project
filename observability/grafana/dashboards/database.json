          "expr": "hikaricp_connections_acquire_seconds_max{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"}",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 8,
