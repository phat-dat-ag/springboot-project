{
  "uid": "sb5-database",
  "title": "Spring Boot / Database & Connection Pools",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "springboot",
    "phase5"
  ],
  "description": "Database & Connection Pools. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Active connections",
      "type": "timeseries",
      "description": "Active connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"}",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Idle connections",
      "type": "timeseries",
      "description": "Idle connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
