      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_max{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"}",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Pool utilization",
      "type": "timeseries",
      "description": "Unknown/zero maximum excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "hikaricp_connections_active{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"} / (hikaricp_connections_max{service=~\"$service\",environment=~\"$environment\",service=~\"user-learning|learning-api\"} > 0)",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Mean connection acquisition latency",
      "type": "timeseries",
      "description": "Mean connection acquisition latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment,pool) (rate(hikaricp_connections_acquire_seconds_sum{service=~\"$service\",environment=~\"$environment\"}[$__rate_interval])) / (sum by (service,environment,pool) (rate(hikaricp_connections_acquire_seconds_count{service=~\"$service\",environment=~\"$environment\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Connection timeouts",
      "type": "timeseries",
      "description": "Connection timeouts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment,pool) (rate(hikaricp_connections_timeout_total{service=~\"$service\",environment=~\"$environment\"}[$__rate_interval]))",
          "legendFormat": "{{service}} {{pool}}",
          "editorMode": "code"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Pool acquisition maximum",
      "type": "timeseries",
      "description": "Micrometer time-window maximum, not lifetime maximum.",
      "datasource": {
