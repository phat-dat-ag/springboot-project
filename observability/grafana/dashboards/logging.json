          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service,level) (rate(({job=\"springboot\",service=~\"$service\",environment=~\"$environment\"} | json | __error__=\"\")[$__interval]))",
          "legendFormat": "{{service}} {{level}}",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 100
