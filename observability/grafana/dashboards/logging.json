  "templating": {
    "list": [
      {
        "name": "environment",
        "label": "Environment",
        "type": "query",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "label_values(app_build_info, environment)",
        "options": [],
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(app_build_info, environment)",
        "refresh": 1
      },
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "query": "user-learning,learning-api,jwks-service",
        "options": []
      },
      {
        "name": "correlation",
        "label": "Correlation ID regex (.* = all)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "trace",
        "label": "Trace ID regex (.* = all)",
        "type": "textbox",
        "query": ".*",
