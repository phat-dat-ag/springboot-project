{
  "uid": "sb5-logging",
  "title": "Spring Boot / Centralized Logging",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "springboot",
    "phase5"
  ],
  "description": "Centralized Logging. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Log investigation",
      "type": "text",
      "description": "Log investigation",
      "options": {
        "mode": "markdown",
        "content": "Use an exact correlation ID or trace ID; default .* includes records with absent optional fields. Expand JSON details and choose TraceID \u2192 View trace. Sampling means some log trace IDs have no stored trace."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Log volume by service",
      "type": "timeseries",
      "description": "Stream labels only; no request IDs become labels.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "logs",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (service) (rate({job=\"springboot\",service=~\"$service\",environment=~\"$environment\"}[$__interval]))",
          "legendFormat": "{{service}}",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Log volume by severity",
      "type": "timeseries",
      "description": "Log volume by severity",
      "datasource": {
        "type": "loki",
