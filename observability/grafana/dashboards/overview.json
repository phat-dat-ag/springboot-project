    {
      "title": "HTTP p50 latency",
      "type": "timeseries",
      "description": "Histogram interpolation; no observation when no requests occurred.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
