        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (service,environment,le) (rate(http_server_requests_seconds_bucket{service=~\"$service\",environment=~\"$environment\",uri!~\"/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "editorMode": "code"
