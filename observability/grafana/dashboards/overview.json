{
  "uid": "sb5-overview",
  "title": "Spring Boot / Microservices Overview",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "springboot",
    "phase5"
  ],
  "description": "Microservices Overview. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Reading this dashboard",
      "type": "text",
      "description": "Reading this dashboard",
      "options": {
        "mode": "markdown",
        "content": "Availability is the scrape result, not a business transaction. Zero throughput means a successful scrape with no requests. Missing telemetry remains a gap. HTTP panels exclude Actuator routes; quiet latency panels are expected."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Service availability",
      "type": "timeseries",
      "description": "1 = private metrics target reachable; 0 = scrape failed. Missing targets require MissingMetrics alert.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{job=\"springboot\",service=~\"$service\",environment=~\"$environment\"}",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "HTTP requests per second",
      "type": "timeseries",
      "description": "HTTP requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sb:http_requests:rate5m{service=~\"$service\",environment=~\"$environment\"}",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "HTTP 4xx per second",
      "type": "timeseries",
      "description": "HTTP 4xx per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment) (rate(http_server_requests_seconds_count{service=~\"$service\",environment=~\"$environment\",uri!~\"/actuator/.*\",status=~\"4..\"}[$__rate_interval])) or on (service,environment) (0 * sb:http_requests:rate5m{service=~\"$service\",environment=~\"$environment\"})",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
