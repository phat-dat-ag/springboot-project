            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment) (jvm_memory_max_bytes{service=~\"$service\",environment=~\"$environment\",area=\"heap\"} > 0)",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Heap utilization",
      "type": "timeseries",
      "description": "Only positive known pool maxima contribute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
