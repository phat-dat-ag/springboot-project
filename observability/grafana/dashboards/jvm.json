{
  "uid": "sb5-jvm",
  "title": "Spring Boot / JVM & Runtime",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "springboot",
    "phase5"
  ],
  "description": "JVM & Runtime. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Heap used",
      "type": "timeseries",
      "description": "Heap used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment) (jvm_memory_used_bytes{service=~\"$service\",environment=~\"$environment\",area=\"heap\"})",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Heap maximum",
      "type": "timeseries",
      "description": "Heap maximum",
      "datasource": {
        "type": "prometheus",
