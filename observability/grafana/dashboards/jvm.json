          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment) (jvm_memory_used_bytes{service=~\"$service\",environment=~\"$environment\",area=\"heap\"}) / (sum by (service,environment) (jvm_memory_max_bytes{service=~\"$service\",environment=~\"$environment\",area=\"heap\"} > 0) > 0)",
          "legendFormat": "{{service}}",
          "editorMode": "code"
