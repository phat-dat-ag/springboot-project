    {
      "title": "Authentication and authorization logs",
      "type": "logs",
      "description": "Authentication and authorization logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"springboot\",service=~\"$service\",environment=~\"$environment\"} | json category=`[\"error.category\"]` | __error__=\"\" | category=~\"authentication|authorization\"",
          "legendFormat": "{{service}}",
          "editorMode": "code",
          "queryType": "range",
          "maxLines": 100
        }
      ],
      "id": 8,
