{
  "uid": "sb5-security",
  "title": "Spring Boot / Security & Authentication",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "tags": [
    "springboot",
    "phase5"
  ],
  "description": "Security & Authentication. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Security event meaning",
      "type": "text",
      "description": "Security event meaning",
      "options": {
        "mode": "markdown",
        "content": "Counters classify terminal HTTP results. Login/refresh failure includes invalid input and server errors; 401 alone is not proof of an attack. No separately instrumented cryptographic token-validation counter exists."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Authentication failures",
      "type": "timeseries",
      "description": "Authentication failures",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service,environment) (rate(app_security_events_total{service=~\"$service\",environment=~\"$environment\",operation=~\"authentication|internal_authentication|login|refresh\",result=\"failure\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "editorMode": "code"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Authorization denials",
