    {
      "title": "Collector queue utilization",
      "type": "timeseries",
      "description": "Configured byte queue; size/capacity ratio is dimensionless despite generic upstream HELP text.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
