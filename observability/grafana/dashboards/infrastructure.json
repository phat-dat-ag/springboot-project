      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "otelcol_exporter_queue_size{service=~\"$service\",environment=~\"$environment\"} / (otelcol_exporter_queue_capacity{service=~\"$service\",environment=~\"$environment\"} > 0)",
