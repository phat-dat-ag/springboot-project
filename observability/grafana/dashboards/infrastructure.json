  ],
  "description": "Observability Infrastructure. Missing series remain gaps; idle percentiles have no value. See observability/dashboards.md.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "title": "Coverage and limitations",
      "type": "text",
      "description": "Coverage and limitations",
      "options": {
        "mode": "markdown",
        "content": "UP means metrics endpoint reachable, not a full ingest/query transaction. OpenSearch has no Prometheus exporter: use the existing protected local cluster-health check; no cluster-health gauge is fabricated. Backend disk capacity and Fluent Bit output-buffer saturation are unavailable as reliable collected metrics. App disk_* gauges describe their mounted filesystem only and do not monitor backend volumes."
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "All scrape target health",
      "type": "timeseries",
      "description": "All scrape target health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bool",
          "noValue": "No telemetry",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "up{service=~\"$service\",environment=~\"$environment\"}",
          "legendFormat": "{{service}} {{instance}}",
          "editorMode": "code"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
