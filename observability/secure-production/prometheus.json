{
  "global": {
    "scrape_interval": "15s",
    "evaluation_interval": "15s"
  },
  "rule_files": [
    "/etc/prometheus/rules/phase5.json"
  ],
  "scrape_configs": [
    {
      "job_name": "springboot",
      "scheme": "https",
      "scrape_interval": "15s",
      "scrape_timeout": "5s",
      "sample_limit": 20000,
      "tls_config": {
        "ca_file": "/run/tls/ca.pem",
        "cert_file": "/run/tls/client.crt",
        "key_file": "/run/tls/client.key",
        "insecure_skip_verify": false
      },
      "file_sd_configs": [
        {
          "files": [
            "/etc/prometheus/targets/applications.json"
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "__address__"
          ],
          "target_label": "instance"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "(.+):9091",
          "target_label": "__address__",
          "replacement": "${1}:9092"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "fluent-bit:2020",
          "target_label": "__address__",
          "replacement": "fluent-bit:2021"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "otel-collector:8888",
          "target_label": "__address__",
          "replacement": "otel-collector:8889"
        },
        {
          "source_labels": [
            "service"
          ],
          "regex": "fluent-bit",
          "target_label": "__metrics_path__",
          "replacement": "/api/v1/metrics/prometheus"
        }
      ],
      "metrics_path": "/actuator/prometheus",
      "honor_labels": true,
      "label_limit": 20
    },
    {
      "job_name": "observability",
      "scheme": "https",
      "scrape_interval": "15s",
      "scrape_timeout": "5s",
      "sample_limit": 20000,
      "tls_config": {
        "ca_file": "/run/tls/ca.pem",
        "cert_file": "/run/tls/client.crt",
        "key_file": "/run/tls/client.key",
        "insecure_skip_verify": false
      },
      "file_sd_configs": [
        {
          "files": [
            "/etc/prometheus/targets/infrastructure.json"
          ]
        }
      ],
      "relabel_configs": [
        {
          "source_labels": [
            "service"
          ],
          "regex": "grafana",
          "action": "drop"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "target_label": "instance"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "(.+):9091",
          "target_label": "__address__",
          "replacement": "${1}:9092"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "fluent-bit:2020",
          "target_label": "__address__",
          "replacement": "fluent-bit:2021"
        },
        {
          "source_labels": [
            "__address__"
          ],
          "regex": "otel-collector:8888",
          "target_label": "__address__",
          "replacement": "otel-collector:8889"
        },
        {
          "source_labels": [
            "service"
          ],
          "regex": "fluent-bit",
          "target_label": "__metrics_path__",
          "replacement": "/api/v1/metrics/prometheus"
        }
      ]
    },
    {
      "job_name": "grafana-secure",
      "scheme": "https",
      "tls_config": {
        "ca_file": "/run/tls/ca.pem",
        "cert_file": "/run/tls/client.crt",
        "key_file": "/run/tls/client.key",
        "insecure_skip_verify": false
      },
      "static_configs": [
        {
          "targets": [
            "grafana:3000"
          ],
          "labels": {
            "service": "grafana",
            "environment": "production"
          }
        }
      ],
      "basic_auth": {
        "username": "prometheus",
        "password_file": "/run/tls/grafana-metrics-password"
      },
      "relabel_configs": [
        {
          "target_label": "job",
          "replacement": "observability"
        }
      ]
    }
  ]
}
