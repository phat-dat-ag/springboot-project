# INACTIVE CANDIDATE ONLY. Copy outside Git and supply authorized material.
# Required: absolute existing directory of per-service TLS identities. No defaults.
OBS_TLS_DIR=
# Required: reviewed rendered OpenSearch security YAML directory with real bcrypt hashes.
OS_SECURITY_CONFIG_DIR=
# Required: exact certificate DNs; public identifiers, not credentials.
OS_ADMIN_DN=
OS_NODE_DN=
# Required: operator-provisioned existing backend server credential; never invent one.
OS_DASHBOARDS_PASSWORD=
# Required: HTTPS URL matching the supplied Grafana certificate / ingress DNS.
OBS_GRAFANA_ROOT_URL=
# Required: metrics-only Grafana password; must match prometheus/grafana-metrics-password.
GRAFANA_METRICS_PASSWORD=
# Required: multiline authorized client/CA PEMs for datasource TLS. Never commit filled values.
GRAFANA_TLS_CA_PEM=
GRAFANA_TLS_CLIENT_CERT_PEM=
GRAFANA_TLS_CLIENT_KEY_PEM=
# All existing root .env settings remain required; production identity is supplied by overlay.
# No development value, key or password is overwritten by this example.
