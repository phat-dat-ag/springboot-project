    "fluent-bit": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/fluent-bit",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/fluent-bit.conf",
          "target": "/fluent-bit/etc/fluent-bit.conf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "environment": {
        "DEPLOYMENT_ENVIRONMENT": "production"
      }
    },
    "otel-collector": {
