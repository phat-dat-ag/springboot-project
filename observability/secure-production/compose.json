          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
    "tempo": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/tempo",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/tempo.yml",
          "target": "/etc/tempo/tempo.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
    "prometheus": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/prometheus",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/prometheus.json",
          "target": "/etc/prometheus/prometheus.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/prometheus-web.json",
          "target": "/etc/prometheus/web.json",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/prometheus-client.json",
          "target": "/etc/prometheus/client.json",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/targets",
          "target": "/etc/prometheus/targets",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.path=/prometheus",
        "--storage.tsdb.retention.time=15d",
        "--storage.tsdb.retention.size=2GB",
        "--web.listen-address=0.0.0.0:9090",
        "--web.config.file=/etc/prometheus/web.json"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "promtool",
          "check",
          "ready",
          "--url=https://prometheus:9090",
          "--http.config.file=/etc/prometheus/client.json"
        ]
      }
    },
    "grafana": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/grafana",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/datasources/loki.yml",
          "target": "/etc/grafana/provisioning/datasources/loki.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/datasources/prometheus.yml",
          "target": "/etc/grafana/provisioning/datasources/prometheus.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/datasources/tempo.yml",
          "target": "/etc/grafana/provisioning/datasources/tempo.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/alerting.json",
          "target": "/etc/grafana/provisioning/alerting/phase5.json",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "environment": {
        "GF_SERVER_PROTOCOL": "https",
        "GF_SERVER_CERT_FILE": "/run/tls/server.crt",
        "GF_SERVER_CERT_KEY": "/run/tls/server.key",
        "GF_SECURITY_COOKIE_SECURE": "true",
        "GF_METRICS_BASIC_AUTH_USERNAME": "prometheus",
        "GF_SERVER_ROOT_URL": "${OBS_GRAFANA_ROOT_URL:?Supply approved HTTPS Grafana URL}",
        "GF_METRICS_BASIC_AUTH_PASSWORD": "${GRAFANA_METRICS_PASSWORD:?Supply authorized metrics password}",
        "GRAFANA_TLS_CA_PEM": "${GRAFANA_TLS_CA_PEM:?Supply authorized PEM through ignored environment}",
        "GRAFANA_TLS_CLIENT_CERT_PEM": "${GRAFANA_TLS_CLIENT_CERT_PEM:?Supply authorized PEM through ignored environment}",
        "GRAFANA_TLS_CLIENT_KEY_PEM": "${GRAFANA_TLS_CLIENT_KEY_PEM:?Supply authorized PEM through ignored environment}"
      }
    },
    "opensearch": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/opensearch",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/opensearch",
          "target": "/usr/share/opensearch/config/telemetry-tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/opensearch.yml",
          "target": "/usr/share/opensearch/config/opensearch.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "${OS_SECURITY_CONFIG_DIR:?Supply reviewed externally rendered security YAML files}",
          "target": "/usr/share/opensearch/config/opensearch-security",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "environment": {
        "DISABLE_SECURITY_PLUGIN": "false",
        "DISABLE_INSTALL_DEMO_CONFIG": "true",
        "OS_ADMIN_DN": "${OS_ADMIN_DN:?Supply approved admin certificate DN}",
        "OS_NODE_DN": "${OS_NODE_DN:?Supply approved node certificate DN}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl --fail --silent --cacert /run/tls/ca.pem --cert /run/tls/client.crt --key /run/tls/client.key 'https://opensearch:9200/_cluster/health?wait_for_status=yellow&timeout=5s' >/dev/null"
        ]
      }
    },
    "opensearch-dashboards": {
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/opensearch-dashboards",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/opensearch_dashboards.yml",
          "target": "/usr/share/opensearch-dashboards/config/opensearch_dashboards.yml",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "environment": {
        "OPENSEARCH_HOSTS": "[\"https://opensearch:9200\"]",
        "DISABLE_SECURITY_DASHBOARDS_PLUGIN": "false",
        "OS_DASHBOARDS_PASSWORD": "${OS_DASHBOARDS_PASSWORD:?Supply existing authorized server credential}"
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl --fail --silent --max-time 5 --cacert /run/tls/ca.pem https://opensearch-dashboards:5601/ >/dev/null"
        ]
      }
    },
    "user-api-metrics-tls": {
      "image": "nginx@sha256:73c75df4075c918f91017fdda46ad81e55e5af77ba3a64ca3d5014bd9244fe7f",
      "user": "10001:10001",
      "network_mode": "service:user-api",
      "depends_on": {
        "user-api": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "32m",
      "cpus": 0.25,
      "pids_limit": 32,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,nodev,size=8m,uid=10001,gid=10001"
      ],
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-c",
        "/etc/nginx/nginx.conf",
        "-g",
        "daemon off;"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "${OBS_TLS_DIR:?Supply existing authorized per-service certificates; no generation is performed}/user-api",
          "target": "/run/tls",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "./observability/secure-production/user-api-metrics-tls.conf",
          "target": "/etc/nginx/nginx.conf",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ]
    },
