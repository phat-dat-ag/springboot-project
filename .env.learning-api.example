# Copy to .env.learning-api. These are Learning's own keys, never User's private keys.
# Paths are container paths under /run/keys/learning (LEARNING_SIGNING_KEYS_DIR on host).
# Use RSA PKCS#8 PEM private keys, at least 2048 bits. Exactly one key must be active.
# Every listed key is loaded and validated at startup, including inactive keys.
APP_SECURITY_SIGNING_KEYS_0_KID=learning-rsa-v1
APP_SECURITY_SIGNING_KEYS_0_PRIVATEKEYPATH=/run/keys/learning/learningservice-private-v1.pem
APP_SECURITY_SIGNING_KEYS_0_ACTIVE=true

# Optional rotation key: uncomment all fields after generating a separate Learning v2 pair.
# APP_SECURITY_SIGNING_KEYS_1_KID=learning-rsa-v2
# APP_SECURITY_SIGNING_KEYS_1_PRIVATEKEYPATH=/run/keys/learning/learningservice-private-v2.pem
# APP_SECURITY_SIGNING_KEYS_1_ACTIVE=false

# --- Docker Compose debug settings (root .env only) ---
# Set these in the workspace root .env or shell, not this service env_file.
# They apply only when docker-compose.debug.yml is explicitly included.
# LEARNING_API_DEBUG_PORT=5006
# LEARNING_API_JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:${LEARNING_API_DEBUG_PORT:-5006}
# No DEBUG_ENABLED flag is used; the override file enables debugging.

# --- Phase 0 service observability ---
# Stable default: SPRING_APPLICATION_NAME=learning-api. Preserve it for existing log queries.
# Optional per-service release version; otherwise Maven project.version is used.
# APP_VERSION=0.0.1-SNAPSHOT
# DEPLOYMENT_ENVIRONMENT is supplied by root Compose; configure it in root .env.
# Optional local instrumentation controls; missing dependencies are not added by these flags.
# MANAGEMENT_METRICS_ENABLE_ALL=true
# MANAGEMENT_TRACING_ENABLED=true
# MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1
# MANAGEMENT_OTLP_METRICS_EXPORT_ENABLED=false
# MANAGEMENT_TRACING_EXPORT_OTLP_ENABLED=false
# MANAGEMENT_LOGGING_EXPORT_OTLP_ENABLED=false
# Keep exposure at health; metrics access/security will be designed in Phase 2.
# MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health
